# Copy to .env and adjust. All variables are prefixed with MLFLOW_ENT_.

# URI of the MLflow tracking server (default port 5000).
MLFLOW_ENT_TRACKING_URI=http://localhost:5000

# Optional dedicated model registry URI (defaults to the tracking URI).
# MLFLOW_ENT_REGISTRY_URI=http://localhost:5000

# Default experiment name used when none is passed explicitly.
MLFLOW_ENT_EXPERIMENT_NAME=Default

# S3 URI for the artifact store (matches the Terraform artifact-store module).
MLFLOW_ENT_ARTIFACT_LOCATION=s3://mlflow-enterprise-artifacts/

# HTTP request timeout in seconds.
MLFLOW_ENT_REQUEST_TIMEOUT_SECONDS=30

# AWS credentials for the S3 artifact store are read from the standard AWS
# environment / instance profile. Do not commit real secrets.
# AWS_REGION=us-east-1
